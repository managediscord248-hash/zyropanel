# ==============================================================================
# ZYROCLOUD CONTROL PANEL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
PANEL_PORT=3000
PANEL_HOST=0.0.0.0
NODE_ENV=production
APP_SECRET=zyrocloud_super_secret_jwt_encryption_key_change_me_in_production_min32chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://zyrocloud:zyrocloud_secure_pass_123@postgres:5432/zyrocloud_db
POSTGRES_USER=zyrocloud
POSTGRES_PASSWORD=zyrocloud_secure_pass_123
POSTGRES_DB=zyrocloud_db
POSTGRES_PORT=5432

# Storage & Directory Isolation Paths
DATA_DIRECTORY=/var/lib/zyrocloud
SERVERS_DIRECTORY=/var/lib/zyrocloud/servers
BACKUPS_DIRECTORY=/var/lib/zyrocloud/backups
PLAYIT_DIRECTORY=/var/lib/zyrocloud/playit
LOGS_DIRECTORY=/var/lib/zyrocloud/logs

# Docker Daemon Configuration
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=zyrocloud-network

# Initial Administrator Credentials (used only on initial bootstrap)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@zyrocloud.local
ADMIN_PASSWORD=ZyroCloud2026!SecureAdmin

# Playit.gg Tunnel Integration (Optional)
PLAYIT_ENABLED=true
PLAYIT_BINARY_PATH=/usr/local/bin/playit
PLAYIT_SECRET_KEY=

# Cloudflare Tunnel Integration (Optional - disabled by default)
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=

# ==============================================================================
# SOCIAL AUTHENTICATION (OAuth 2.0 / OpenID Connect)
# ==============================================================================

# Application Base URL (Required for OAuth redirects)
# Example: https://ais-dev-kowln4fnwze2y2oqp5lx2x-906902895287.asia-southeast1.run.app
APP_URL=

# Google OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Discord OAuth2 Credentials
# Obtain from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
